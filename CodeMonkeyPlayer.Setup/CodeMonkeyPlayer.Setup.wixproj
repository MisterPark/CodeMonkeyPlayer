<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>CodeMonkeyPlayer-Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\CodeMonkeyPlayer\bin\$(Configuration)</PayloadDir>
    <DefineConstants>PayloadDir=$(PayloadDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeMonkeyPlayer\CodeMonkeyPlayer.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
  <Target Name="CheckPayload" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(PayloadDir)\CodeMonkeyPlayer.exe')" Text="Build the player and restore libmpv using Build-Installer.ps1." />
  </Target>
</Project>
